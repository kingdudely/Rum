# Maintainer: komaruworld <rtysus228@gmail.com>

pkgname=mocktail
pkgver=1.0.3
pkgrel=2
pkgdesc='Android x86-64 Roblox compatibility runtime for Linux'
arch=('x86_64')
url='https://github.com/komaruworld/mocktail'
license=('Apache-2.0')
depends=(
  'curl'
  'fontconfig'
  'libelf'
  'libglvnd'
  'libplacebo'
  'libpng'
  'libutf8proc'
  'libyaml'
  'nlohmann-json'
  'openssl'
  'sdl3>=3.4'
  'sdl3_ttf'
  'vulkan-icd-loader'
  'zlib'
)
makedepends=(
  'cmake>=3.20'
  'git'
  'lld'
  'ninja'
  'pkgconf'
)
optdepends=('gamemode: Feral GameMode integration')
options=('!debug' 'strip')
source=()
sha256sums=()

_mocktail_source_dir="${MOCKTAIL_SOURCE_DIR:-${startdir}/../..}"

prepare() {
  [[ -f "${_mocktail_source_dir}/CMakeLists.txt" ]] ||
    error 'run makepkg from a complete Mocktail checkout'
}

build() {
  cmake -S "${_mocktail_source_dir}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DMOCKTAIL_DEFAULT_COMPATIBILITY_MANIFEST=/usr/share/mocktail/metadata/roblox_compatibility.json \
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
